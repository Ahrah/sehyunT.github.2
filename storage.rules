rules_version = '2';

// Firebase Storage Security Rules for sehyunt.re.kr
// Admin email: ahrah0365@gmail.com

service firebase.storage {
  match /b/{bucket}/o {
    
    // Resources images (uploaded via Article posts)
    // - Public read access (anyone can view published images)
    // - Write access ONLY for admin email
    match /resources/images/{imageId} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.auth.token.email == 'ahrah0365@gmail.com';
    }
    
    // Gallery images (if needed in future)
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.auth.token.email == 'ahrah0365@gmail.com';
    }
    
    // Default: deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
