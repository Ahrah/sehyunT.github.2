rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "ahrah0365@gmail.com";
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /gallery/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /resources/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /resourceBodies/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /resourcePasswords/{resourceId} {
      allow read, write: if isAdmin();
    }

    // 진로 컨설팅 신청.
    // 목록(list)은 관리자만. 신청자는 본인 문서(get)만 읽을 수 있다.
    // 관리자는 상태(submitted 신규 / contacted 연락함)와 updatedAt 만 바꿀 수 있다.
    // 이 규칙은 앱이 쓰는 이름 있는 데이터베이스에 배포해야 한다.
    // database: ai-studio-d952e7b8-7279-465e-ace8-9b4ca51fec63
    // project: gen-lang-client-0337316086
    match /careerCounselingApplications/{applicationId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'submitted';
      allow get: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['submitted', 'contacted'];
      allow delete: if isAdmin();
    }
  }
}
