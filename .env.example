# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Configuration (Optional if using firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# PayUp "URL 링크 결제" checkout links — one per product/business.
# Set in PayUp merchant admin after that business's PG account is approved,
# then set as a GitHub repo Variable (not Secret — these aren't sensitive)
# so the deploy workflow can inject them at build time. See src/payment/config.ts
# and src/payment/merchants.ts (사업자 정보는 merchants.ts에서 직접 관리).
VITE_PAYUP_ADMISSION_CONSULTING_URL=
VITE_PAYUP_ADMISSION_CONSULTING_NAME=
VITE_PAYUP_ADMISSION_CONSULTING_PRICE=

VITE_PAYUP_HOBBY_SUBSCRIPTION_URL=
VITE_PAYUP_HOBBY_SUBSCRIPTION_NAME=
VITE_PAYUP_HOBBY_SUBSCRIPTION_PRICE=

# Comma-separated extra hostnames to trust as PayUp checkout destinations,
# in addition to payup.co.kr (always allowed). Only set this if PayUp gives
# you a link on a different domain — never add an untrusted host here.
VITE_PAYUP_ALLOWED_HOSTS=
